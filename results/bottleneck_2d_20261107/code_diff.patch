+
+def alpha_cell() -> float:
+    """Pr(argmax(e_0 + H Z) = 0) for Z ~ N(0, I_3)."""
+    from scipy.integrate import quad
+    from scipy.stats import norm
+    return quad(lambda z: norm.pdf(z) * norm.cdf(z + 1 / H) ** 2, -12, 12, epsabs=1e-13)[0]
+
+
+B_Q = math.log(2 * alpha_cell() / (1 - alpha_cell()))
